# 공공데이터 API 키 (발급: data.go.kr / kosis.kr / Google Cloud Console)
DATA_GO_KR_KEY=
KOSIS_API_KEY=
GOOGLE_PLACES_API_KEY=

# LLM — Ollama(OpenAI 호환), 로컬 GPU 서빙
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=finpilot
OLLAMA_BASE_URL=http://localhost:11434

# 임베딩 (Ollama bge-m3)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# (선택) 외부 폴백 LLM — vLLM/Ollama 실패 시 사용
# FALLBACK_LLM_API_KEY=
# FALLBACK_LLM_MODEL=gpt-4o-mini

# (운영 권장) config.py 기본값을 덮어쓰는 보안 항목 — 프로덕션에서 반드시 교체
# SECRET_KEY=change-me-in-production
# POSTGRES_PASSWORD=change-me
