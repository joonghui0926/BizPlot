# API 베이스 URL
#  - 로컬: 같은 오리진 프록시 (/api → next.config rewrites → :8000)
#  - Vercel: 백엔드를 절대 URL로 직접 호출
NEXT_PUBLIC_API_URL=https://api.bizplot.co.kr/api

# 공공데이터
DATA_GO_KR_KEY=
KOSIS_API_KEY=
GOOGLE_PLACES_API_KEY=

# OAuth 로그인 키/시크릿은 backend/.env에만 둔다.
# 프론트는 /api/auth/kakao, /api/auth/google로 이동만 한다.
