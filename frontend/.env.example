# API 베이스 URL
#  - 로컬/올-KAIST: 같은 오리진 프록시 (/api → next.config rewrites → :8000)
#  - Vercel 하이브리드: KAIST 백엔드를 절대 URL로 직접 호출
NEXT_PUBLIC_API_URL=/api
# 예) Vercel 환경변수에 설정: NEXT_PUBLIC_API_URL=https://api.bizplot.co.kr/api

# 공공데이터
DATA_GO_KR_KEY=
KOSIS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Kakao / Google OAuth (브라우저 노출용은 NEXT_PUBLIC_ 접두)
NEXT_PUBLIC_KAKAO_REST_KEY=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
